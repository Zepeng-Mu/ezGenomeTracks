# Use plotgardenerData ----
library(plotgardenerData)
data("GM12878_HiC_10kb")
data("IMR90_HiC_10kb")
data("GM12878_ChIP_CTCF_signal")
data("IMR90_ChIP_CTCF_signal")
data("GM12878_ChIP_H3K27ac_signal")
data("IMR90_ChIP_H3K27ac_signal")

tmpRegion <- "chr21:29050000-29150000"

mockPeak <- data.frame(
  chr = "chr21",
  start = runif(5, min = 29000000, max = 29150000)
) %>%
  dplyr::mutate(end = start + 500, name = LETTERS[sample(1:26, 5)])

ggplot(mockPeak) +
  geom_rect(aes(xmin = start, xmax = end, y = 1, height = 1), color = "red") +
  theme(axis.text.y = element_text(size = rel(2)))

ez_feature(mockPeak, region = tmpRegion)
ez_gene(TxDb.Hsapiens.UCSC.hg19.knownGene, region = tmpRegion, exon_height = 0.5)

genome_plot(p1, p2, region = tmpRegion)

ez_hic(GM12878_HiC_10kb, region = tmpRegion)

ez_coverage(
  GM12878_ChIP_CTCF_signal, color = "green",
  region = "chr21:28050000-28051000",y_range = c(0, 5)
)

ezGenomeTracks:::plot_signal_df(
  rbind(
    GM12878_ChIP_CTCF_signal %>% mutate(name = "G1"),
    GM12878_ChIP_H3K27ac_signal %>% mutate(name = "G2")
  ),
  region = tmpRegion,
  group_by = "name",
  color_by = "name"
)

ezGenomeTracks:::plot_signal_df(
  rbind(
    GM12878_ChIP_CTCF_signal %>% mutate(name = "G1"),
    GM12878_ChIP_H3K27ac_signal %>% mutate(name = "G2")
  ),
  colors = c("orange", "blue"),
  track_by = "name",
  region = tmpRegion,
  type = "area"
)

g2 <- ez_feature(mockPeak, region = tmpRegion, fill = "blue", color = "blue")

ggplot(GM12878_ChIP_CTCF_signal) +
  geom_coverage(type = "area", show.legend = F, color = "green") +
  scale_x_genome_region("chr21:29053000-29064000") +
  scale_y_continuous(limits = c(0, 5))

ggplot(
  rbind(
    GM12878_ChIP_CTCF_signal %>% mutate(name = "G1"),
    GM12878_ChIP_H3K27ac_signal %>% mutate(name = "G2")
  ),
  aes(xmin = start, xmax = end, ymax = score)
) +
  geom_coverage(type = "area", show.legend = F) +
  facet_wrap(~name, ncol = 1) +
  ez_signal_theme()

genome_plot(g1, g2, region = tmpRegion, heights = 1)

ez_signal(
  data = GM12878_ChIP_H3K27ac_signal,
  region = tmpRegion,
  fill = "red2",
  color = "red2",
  y_range = c(0, 50)
) +
  ggtitle(label = "", subtitle = "CTCF")


